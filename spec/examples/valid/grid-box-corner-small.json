{
  "$schema": "https://markurtz.github.io/mav-grid/schema/0.11.0-draft.1/part.schema.json",
  "mav_grid": "0.11.0-draft.1",
  "class": "grid",
  "id": "box-corner-small",
  "name": "Two faces around a box corner, Small",
  "maker": "MAV Grid project",
  "licence": "Apache-2.0 WITH SHL-2.0",
  "claim_line": "MAV Grid 0.11.0-draft.1 · Small · 2 faces (4 × 3, 2 × 3) · Swap base",
  "faces": [
    {
      "id": "side-a",
      "size": "small",
      "build_mode": "swap-base",
      "cols": 4,
      "rows": 3,
      "edges": {
        "x_max": {
          "type": "fold",
          "fold": "corner"
        }
      },
      "plates": [
        {
          "at": [
            0,
            0
          ],
          "span": [
            2,
            3
          ],
          "kind": "plain",
          "state": "loose",
          "fixing": "screw",
          "fixing_cells": "standard"
        },
        {
          "at": [
            2,
            0
          ],
          "span": [
            2,
            3
          ],
          "kind": "plain",
          "state": "loose",
          "fixing": "screw",
          "fixing_cells": "standard"
        }
      ],
      "core": {
        "material": "wood-sheet",
        "thickness": 12.0,
        "holes": "all-cells",
        "fixing": "wood-insert"
      }
    },
    {
      "id": "side-b",
      "size": "small",
      "build_mode": "swap-base",
      "cols": 2,
      "rows": 3,
      "edges": {
        "x_min": {
          "type": "fold",
          "fold": "corner"
        }
      },
      "plates": [
        {
          "at": [
            0,
            0
          ],
          "span": [
            1,
            3
          ],
          "kind": "plain",
          "state": "loose",
          "fixing": "screw",
          "fixing_cells": "standard"
        },
        {
          "at": [
            1,
            0
          ],
          "span": [
            1,
            3
          ],
          "kind": "plain",
          "state": "loose",
          "fixing": "screw",
          "fixing_cells": "standard"
        }
      ],
      "core": {
        "material": "wood-sheet",
        "thickness": 12.0,
        "holes": "all-cells",
        "fixing": "wood-insert"
      }
    }
  ],
  "folds": [
    {
      "id": "corner",
      "a": {
        "face": "side-a",
        "edge": "x_max"
      },
      "b": {
        "face": "side-b",
        "edge": "x_min"
      },
      "angle": 270,
      "corner": "solid",
      "fold_rows": "relieved"
    }
  ],
  "notes": "An outside box corner. At 270 degrees standard Small plates on both faces would meet 5.3 mm below the surface, so the fold rows are relieved (rule S-8)."
}
