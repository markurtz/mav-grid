{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markurtz.github.io/mav-grid/schema/0.11.0-draft.1/support.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0 WITH SHL-2.0",
  "title": "MAV Grid support registry",
  "description": "How each surveyed system version lands on MAV Grid (section 10, rules A-1 and A-2). Levels are intentions from a paper study, not test results.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "spec_version": {
      "$ref": "common.schema.json#/$defs/specVersion"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "counts": {
      "description": "Systems per level. Tools recompute and compare.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/supportLevel"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/system"
      }
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "spec_version",
    "date",
    "counts",
    "systems"
  ],
  "additionalProperties": false,
  "$defs": {
    "system": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "$ref": "common.schema.json#/$defs/supportLevel"
        },
        "intended": {
          "description": "The route the owner set for this version on 2026-11-20.",
          "enum": [
            "native",
            "groove-or-plate",
            "work-in",
            "face-plate",
            "face-plate-adapter",
            "adapter",
            "add-on",
            "to-determine",
            "not-specified"
          ]
        },
        "sizes": {
          "$ref": "common.schema.json#/$defs/sizes"
        },
        "build_modes": {
          "description": "Build modes in which the level holds. Left out when it holds in all four.",
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/buildMode"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "needs": {
          "description": "What the level needs beyond a plain face: a nut thread, a hole size, a plate kind.",
          "type": "string",
          "minLength": 1
        },
        "min_span": {
          "$ref": "common.schema.json#/$defs/span"
        },
        "open_ended": {
          "description": "True when the plate or strip runs any number of rows beyond the minimum.",
          "type": "boolean"
        },
        "kind": {
          "description": "A plate kind id in data/kinds.json.",
          "$ref": "common.schema.json#/$defs/slug"
        },
        "thread": {
          "$ref": "common.schema.json#/$defs/thread"
        },
        "licence": {
          "$ref": "common.schema.json#/$defs/licence"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "popularity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "tags": {
          "$ref": "common.schema.json#/$defs/tags"
        },
        "note": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "family",
        "version",
        "level",
        "intended",
        "sizes",
        "tags"
      ],
      "additionalProperties": false
    }
  }
}
