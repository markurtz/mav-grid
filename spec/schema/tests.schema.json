{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markurtz.github.io/mav-grid/schema/0.11.0-draft.1/tests.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0 WITH SHL-2.0",
  "title": "MAV Grid test and open item list",
  "description": "Every test, look-up and design task that stands between this draft and a proven spec (section 16). Each test states its pass criterion and sample count before it is run.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "spec_version": {
      "$ref": "common.schema.json#/$defs/specVersion"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "gate": {
      "description": "The tests that gate 1.0 (rule V-2).",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/testId"
      },
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "required": [
    "spec_version",
    "date",
    "gate",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/testId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "test",
            "look-up",
            "design"
          ]
        },
        "state": {
          "enum": [
            "open",
            "passed",
            "failed",
            "withdrawn"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ruleId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "pass": {
          "type": "string",
          "minLength": 1
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "after": {
          "description": "Tests that must be done first.",
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/testId"
          },
          "uniqueItems": true
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/findingId"
          },
          "uniqueItems": true
        },
        "tags": {
          "$ref": "common.schema.json#/$defs/tags"
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "state",
        "rules",
        "method"
      ],
      "if": {
        "properties": {
          "type": {
            "const": "test"
          }
        }
      },
      "then": {
        "required": [
          "pass",
          "samples"
        ]
      },
      "additionalProperties": false
    }
  }
}