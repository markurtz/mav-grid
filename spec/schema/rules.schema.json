{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markurtz.github.io/mav-grid/schema/0.11.0-draft.1/rules.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0 WITH SHL-2.0",
  "title": "MAV Grid rule registry",
  "description": "Every rule ID with its title and the conformance classes it binds (section 5). IDs are permanent (rule V-5).",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "spec_version": {
      "$ref": "common.schema.json#/$defs/specVersion"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "classes": {
      "type": "array",
      "items": {
        "enum": [
          "grid",
          "plate",
          "key",
          "adapter",
          "gauge"
        ]
      },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "required": [
    "spec_version",
    "date",
    "classes",
    "rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ruleId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "description": "A withdrawn rule keeps its number.",
          "enum": [
            "active",
            "withdrawn"
          ]
        },
        "binds": {
          "description": "Classes the rule binds. 'all' binds every class. 'spec' binds the project and its documents, not a part.",
          "type": "array",
          "items": {
            "enum": [
              "grid",
              "plate",
              "key",
              "adapter",
              "gauge",
              "all",
              "spec"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "tags": {
          "$ref": "common.schema.json#/$defs/tags"
        },
        "since": {
          "$ref": "common.schema.json#/$defs/specVersion"
        },
        "changed": {
          "description": "The version that last changed the rule text.",
          "$ref": "common.schema.json#/$defs/specVersion"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/findingId"
          },
          "uniqueItems": true
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/decisionId"
          },
          "uniqueItems": true
        },
        "level": {
          "description": "The strongest key word the rule uses (BCP 14).",
          "enum": [
            "must",
            "should",
            "may",
            "definition"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "section",
        "state",
        "level",
        "binds",
        "tags",
        "since"
      ],
      "additionalProperties": false
    }
  }
}
